FROM node:22.5.1-alpine AS builder

WORKDIR /app

# Install dependencies first (layer cache friendly).
COPY package.json package-lock.json ./
RUN npm ci

# Build the production bundle.
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM node:22.5.1-alpine

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Proper signal handling + non-root user for security.
RUN apk add --no-cache dumb-init \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

WORKDIR /app
# Standalone output includes its own traced node_modules + server.js.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
# Static assets and public files are excluded from the standalone build.
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 8322

# Railway injects $PORT; default to 8322 when running outside Railway.
CMD ["sh", "-c", "PORT=${PORT:-8322} node server.js"]
